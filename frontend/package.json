{
  "name": "java-interview-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run tests/unit --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:interactions": "node tests/interactions.mjs",
    "test:ai": "node tests/ai.mjs",
    "test:regressions": "node tests/regressions.mjs",
    "test:unit": "vitest run tests/unit",
    "test:details": "node tests/details.mjs",
    "test:knowledge": "node tests/knowledge.mjs",
    "test:knowledge-core": "node tests/knowledge-core.mjs",
    "test:knowledge-layout": "node tests/knowledge-layout.mjs",
    "test:polish": "node tests/polish.mjs",
    "test:explanations": "node tests/explanations.mjs",
    "test:explanation-reader": "node tests/explanation-reader.mjs",
    "test:deep-reader": "node tests/deep-reader.mjs",
    "test:learning-reader": "node tests/learning-reader.mjs",
    "test:catalog": "node tests/catalog.mjs",
    "test:spring-core-reader": "node tests/spring-core-reader.mjs",
    "test:spring-advanced-reader": "node tests/spring-core-reader.mjs spring-advanced",
    "test:database-basics-reader": "node tests/spring-core-reader.mjs database-basics",
    "test:explanation-pack": "node tests/explanation-pack.mjs",
    "test:review": "node tests/review.mjs",
    "test:data-admin": "node tests/data-admin.mjs",
    "test:e2e": "node tests/smoke.mjs",
    "format": "prettier --write src tests/unit package.json vite.config.ts",
    "format:check": "prettier --check src tests/unit package.json vite.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
