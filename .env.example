ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-random-root-password
HTTP_PORT=8088
COOKIE_SECURE=true

# Optional AI / RAG
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUESTS_PER_HOUR=30
AI_MAX_CONCURRENT=2
AI_CHAT_TIMEOUT_MS=90000
AI_EMBEDDING_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARACTERS=80000
KNOWLEDGE_MAX_CHARACTERS=5000000
KNOWLEDGE_MAX_CHUNKS=10000
KNOWLEDGE_MAX_VECTOR_BYTES=134217728
SEARCH_MAX_CHARACTERS=20000000

# Optional login brute-force throttle
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
